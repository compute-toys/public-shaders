fn mod2(a:vec2f,b:f32)->vec2f
{
    return fract(a/b)*b;
}
fn hash(a:u32) -> u32
{
    var x = a;
    x ^= x >> 17;  x *= 0xed5ad4bbu;
    x ^= x >> 11;  x *= 0xac4c1b51u;
    x ^= x >> 15;  x *= 0x31848babu;
    x ^= x >> 14;  return x;
}
fn rnd(a:u32) -> f32
{
    var h   = hash(a);
    var msk = (1u << 23) - 1u;
    return f32(h & msk) / f32(1u << 23);
}
fn cmul(a:vec2f, b:vec2f) -> vec2f{return vec2f(a.x*b.x - a.y*b.y, a.x*b.y + a.y*b.x);}
fn f(v:f32) -> f32
{
    var a = abs(v);
    var b = 1.f - 1.f/exp(a);
    var c = 1.f; if(v<0.f){c = -1.f;}
    //var d = c*b + 1.f;
    var r = a - b + v;
    return r;
}
fn barforce(p1:vec2f,p2:vec2f, v1:vec2f,v2:vec2f, m:f32) -> vec2f
{
    var np = p1-p2;
    var l  = length(np);
    if(l!=0.f){np = np/l;}

    var a = brsl-l;
    var b = max(0.f,abs(a)-brslr);
    if(a<0.f){b = -b;}

    var f = vec2f(0);
    f += np*m;                                  //manual bar control
    f += np*b * brsf;                           //auto bar atraction
    f += f32(b!=0.f)*dot(v2-v1,np)*np * brsr; //auto bar friction
    return f;
}
fn worldforce(p:vec2f, v:vec2f) -> vec2f
{
    return vec2f(0,1)*grvt + (vec2f(0,-1)*floru + v*florf)*min(0.f,p.y);
}
