fn forwardf(id3: vec3u)
{
    //write last into first
    for(var k=0; k<pdv; k++){D.p[k] = D.p[k+(phyt-1)*pdv];}
    for(var k=0; k<pdv; k++){D.v[k] = D.v[k+(phyt-1)*pdv];}
    //do physics
    for(var i=1; i<phyt; i++)
    {
        var i1 = i-1;
        for(var k=0; k<pdv; k++){D.f[k+i*pdv] = vec2f(0,f32(k!=0))*grvt;}
        if(true){
            var p = D.p[0+i1*pdv];
            var v = D.v[0+i1*pdv];
            var m = D.m[i1];
            D.f[0+i*pdv] += controlforce(p, v, m);
        }
        for(var k=0; k<pdv-1; k++)//bar
        {
            var p1 = D.p[k+0+i1*pdv];
            var v1 = D.v[k+0+i1*pdv];
            var p2 = D.p[k+1+i1*pdv];
            var v2 = D.v[k+1+i1*pdv];
            var f = barforce(p1,p2, v1,v2, brsl);
            D.f[k+0+i*pdv] += f;
            D.f[k+1+i*pdv] -= f;
        }
        var stp = 1.f;//D.t[i1];
        for(var k=0; k<pdv; k++){D.v[k+i*pdv] = D.v[k+i1*pdv]+D.f[k+i*pdv]*stp;}
        for(var k=0; k<pdv; k++){D.p[k+i*pdv] = D.p[k+i1*pdv]+D.v[k+i*pdv]*stp;}
    }

    //mouse direct pendulum
    var c    = vec2f(textureDimensions(screen));
    var zoom = .05f;
    var m    = (2.f*vec2f(mouse.pos)-c)/c.y/zoom*vec2(1,-1);
    var aspd = .9f; //atraction speed
    for(var k=0; k<pdv; k++){D.mt[k]=vec2f(0);}
    D.mt[0    ] += (vec2f(0)-D.pt[    0])*vec2f(   0,aspd);
    D.mt[pdv-1] += (       m-D.pt[pdv-1])*vec2f(aspd,aspd);
    for(var k=0; k<pdv-1; k++)
    {
        var p1 = D.pt[k+0];
        var p2 = D.pt[k+1];
        var mt = vec2f(0);
        {
            var np = p1-p2;
            var l  = length(np);
            if(l!=0.f){np = np/l;}
            mt += np*(brsl-l)*.5f*aspd;
        }
        D.mt[k+0] += mt;
        D.mt[k+1] -= mt;
    }
    for(var k=0; k<pdv; k++){D.pt[k]+=D.mt[k];}
}
#dispatch_once ini
#workgroup_count ini 1 1 1
@compute @workgroup_size(1,1,1)
fn ini(@builtin(global_invocation_id) id3: vec3u)
{
    for(var k=0; k<pdv; k++){D.p[k+(phyt-1)*pdv] = vec2f(0,brsl*f32(k))+f32(k)*.01f;}
    for(var k=0; k<pdv; k++){D.v[k+(phyt-1)*pdv] = vec2f(0);}
    for(var k=0; k<pdv; k++){D.pt[k] = vec2f(0,brsl*f32(k));}
}
#workgroup_count nn1 1 1 1
@compute @workgroup_size(1,1,1)
fn nn1(@builtin(global_invocation_id) id3: vec3u){nnf(id3);}
#workgroup_count forward1 1 1 1
@compute @workgroup_size(1,1,1)
fn forward1(@builtin(global_invocation_id) id3: vec3u){forwardf(id3);}
#workgroup_count nn2 1 1 1
@compute @workgroup_size(1,1,1)
fn nn2(@builtin(global_invocation_id) id3: vec3u){nnf(id3);}
#workgroup_count forward2 1 1 1
@compute @workgroup_size(1,1,1)
fn forward2(@builtin(global_invocation_id) id3: vec3u){forwardf(id3);}
fn sdCapsule(p:vec3f,a:vec3f,b:vec3f,r:f32) -> f32
{
    var pa = p - a;
    var ba = b - a;
    var h = clamp(dot(pa, ba) / dot(ba, ba), 0.f, 1.f);
    return length(pa - ba * h) - r;
}
fn objects(p:vec3f) -> f32
{
    var l = 111111111.f;
    for(var k = 0; k < pdv-1; k++)//union of all pendulum bars
    {
        var p1 = vec3f(D.p[k+0+(phyt-1)*pdv], 0);
        var p2 = vec3f(D.p[k+1+(phyt-1)*pdv], 0);
        l = min(l, sdCapsule(p, p1, p2, brsw));
    }
    return l;
    //return length(p)-1.f;
}
@compute @workgroup_size(8,8,1)
fn draw(@builtin(global_invocation_id) id3: vec3u)
{
    var screenZ = textureDimensions(screen);
    if(any(id3.xy >= screenZ)){ return; }
    var c = vec2f(screenZ);
    var zoom = .05f;
    var u = (2.f*vec2f(   id3.xy)-c)/c.y/zoom*vec2(1,-1);
    var m = (2.f*vec2f(mouse.pos)-c)/c.y/zoom*vec2(1,-1);
    var campos = cos(time.elapsed*float3(-23,-9,27)*.002f+float3(11,2,22));
        //campos = cos(0.f*float3(-23,-9,27)*.02f+float3(11,2,22));
        campos = campdf;
    //if(mouse.click!=0){campos = float3(cos(m.x),m.y,sin(m.x));}
    campos *= camdis;
    var camdir = -normalize(campos);
    var sd = normalize(float3(-camdir.z,0,camdir.x));
    var up = -cross(camdir,sd);

    var p = campos + sd*u.x + up*u.y;
    for(var i = 0; i < 33; i++)
    {
        p += objects(p)*camdir;
    }
    var s  = 1.f/64.f;
    var c1 = vec3f(0);
    var c2 = normalize(vec3f(
        objects(p+vec3f(s,0,0)) - objects(p-vec3f(s,0,0)),//color of surface
        objects(p+vec3f(0,s,0)) - objects(p-vec3f(0,s,0)),
        objects(p+vec3f(0,0,s)) - objects(p-vec3f(0,0,s))));
    if(objects(p)<.1){c1 = c2*.5f+.5f;}
    for(var k = 0; k < pdv; k++){var a = f32(length(u-D.p [k+(phyt-1)*pdv])<.5); c1 = mix(c1,cols[k],a);}
    for(var k = 0; k < pdv; k++){var a = f32(length(u-D.pt[k             ])<.5); c1 = mix(c1,cols[k],a);}
    textureStore(screen, id3.xy, vec4f(c1,1));
}
