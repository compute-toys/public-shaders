fn forwardf(id3: vec3u)
{
    //write last into first
    for(var k=0; k<pdv; k++){D.p[k] = D.p[k+(phyt-1)*pdv];}
    for(var k=0; k<pdv; k++){D.v[k] = D.v[k+(phyt-1)*pdv];}
    //do physics
    for(var i=1; i<phyt; i++)
    {
        var i1 = i-1;
        for(var k=0; k<pdv; k++){D.f[k+i*pdv] = worldforce(D.p[k+i1*pdv],D.v[k+i1*pdv]);}
        for(var k=0; k<rhomz; k++)//bar
        {
            var k1 = rhom[k*2+0];
            var k2 = rhom[k*2+1];
            var p1 = D.p[k1+i1*pdv];
            var v1 = D.v[k1+i1*pdv];
            var p2 = D.p[k2+i1*pdv];
            var v2 = D.v[k2+i1*pdv];
            var m1 = D.m[k +i1*rhomz];
            var f = barforce(p1,p2, v1,v2, m1);
            D.f[k1+i*pdv] += f;
            D.f[k2+i*pdv] -= f;
        }
        var stp = 1.f;//D.t[i1];
        for(var k=0; k<pdv; k++){D.v[k+i*pdv] = D.v[k+i1*pdv]+D.f[k+i*pdv]*stp;}
        for(var k=0; k<pdv; k++){D.p[k+i*pdv] = D.p[k+i1*pdv]+D.v[k+i*pdv]*stp;}
    }
}
