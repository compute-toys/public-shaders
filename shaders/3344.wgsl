//nn = neural network
//use mouse to tell nn where pendulum tip should go
//nn trained on data generated by https://compute.toys/view/3342
//the nn can only control what you control in https://compute.toys/view/3222

#define pi      3.1415926535897932384626433832795
#define thrd    (1<<5)      //gpu threads
#define pdv     3           //pendulum divisions
#define phyt    3           //physics loops total
#define brsf    .2          //bar force
#define brsr    .1          //bar friction
#define brsl    8.          //bar length
#define brsw    1.          //bar radius
#define grvt    -.003       //gravity
#define camdis  22.f        //camera distance
#define campdf  vec3f(0,0,1)//camera pos default
#storage D Doto
struct Doto {
    p: array<vec2f, pdv*phyt>,  //position
    v: array<vec2f, pdv*phyt>,  //velocity
    f: array<vec2f, pdv*phyt>,  //force
    m: array<  f32,     phyt>,  //input movement force
};
fn mod2(a:vec2f,b:f32)->vec2f
{
    return fract(a/b)*b;
}
fn hash(a:u32) -> u32
{
    var x = a;
    x ^= x >> 17;  x *= 0xed5ad4bbu;
    x ^= x >> 11;  x *= 0xac4c1b51u;
    x ^= x >> 15;  x *= 0x31848babu;
    x ^= x >> 14;  return x;
}
fn rnd(a:u32) -> f32
{
    var h   = hash(a);
    var msk = (1u << 23) - 1u;
    return f32(h & msk) / f32(1u << 23);
}
fn f(v:f32) -> f32
{
    var a = abs(v);
    var b = 1.f - 1.f/exp(a);
    var c = 1.f; if(v<0.f){c = -1.f;}
    //var d = c*b + 1.f;
    var r = a - b + v;
    return r;
}
fn barforce(p1:vec2f,p2:vec2f, v1:vec2f,v2:vec2f, barl:f32) -> vec2f
{
    var np = p1-p2;
    var l  = length(np);
    if(l!=0.f){np = np/l;}
    var f = float2(0);
    f += np*(barl-l) * brsf;        //force bar atraction
    f += dot(v2-v1,np)*np * brsr;   //force bar friction
    return f;
}
fn controlforce(p:vec2f, v:vec2f, m:f32) -> vec2f
{
    var yf = (vec2f(0,0)-p) * brsf * vec2f(0,1); //updown force
    var v1 = v * brsr; //friction
    return yf-v1+vec2f(m,0);
}
